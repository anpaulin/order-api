# Routes
# This file defines all application routes (Higher priority routes first)

POST    /orders              controllers.OrderController.create
GET     /orders/search       controllers.OrderController.search(query: models.OrderSearchQuery)
GET     /orders/:id          controllers.OrderController.get(id: java.util.UUID)



PATCH   /orders/:id          controllers.OrderController.update(id: java.util.UUID)
DELETE  /orders/:id          controllers.OrderController.delete(id: java.util.UUID)
